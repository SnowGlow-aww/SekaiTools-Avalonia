<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../SekaiToolsCore/SekaiToolsCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../resource/videoProcess/**" Link="videoProcess/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resource/videoProcess.json" Link="videoProcess.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../SekaiToolsApp/Services/Suppressor.cs" Link="EngineAudit/Suppressor.cs" />
    <Compile Include="../../SekaiToolsApp/Services/SuppressRuntimeService.cs" Link="EngineAudit/SuppressRuntimeService.cs" />
    <Compile Include="../../SekaiToolsApp/Services/X264Params.cs" Link="EngineAudit/X264Params.cs" />
    <Compile Include="../../SekaiToolsApp/Services/EncoderConfig.cs" Link="EngineAudit/EncoderConfig.cs" />
  </ItemGroup>
</Project>
