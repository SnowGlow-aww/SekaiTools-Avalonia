<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <RootNamespace>TimingSelfTest</RootNamespace>
    <AssemblyName>TimingSelfTest</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../SekaiToolsCore/SekaiToolsCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../resource/videoProcess/**" Link="videoProcess/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resource/videoProcess.json" Link="videoProcess.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
